{
	"name": "wuwa-tappo",
	"version": "1.2.1",
	"private": true,
	"type": "commonjs",
	"author": {
		"name": "Asaki Yuki",
		"email": "noreply@asakiyuki.com"
	},
	"description": "Wuwa Tappo - Desktop Companion",
	"scripts": {
		"start": "node scripts/start.cjs",
		"start:nix": "nix-shell --run 'bun start'",
		"renderer:build": "vite build && node scripts/write-renderer-pages.cjs && node scripts/npm-run.cjs renderer:typecheck",
		"test": "node scripts/clean-runtime.cjs && tsc -p tsconfig.test.json && node --test runtime/test.js",
		"build:nix": "nix-shell --run 'bun run build'",
		"build": "node scripts/build-mac-gamepad.cjs && node scripts/build-win-gamepad.cjs && tauri build",
		"renderer:typecheck": "node scripts/typecheck-renderer.cjs",
		"assets:thumbnails": "node scripts/shrink-thumbnails.cjs",
		"format": "prettier --write \"src/**/*.{ts,vue}\" \"scripts/**/*.cjs\" vite.config.mts"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.6",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-vue": "^6.0.11",
		"prettier": "^3.9.10",
		"sass": "^1.107.1",
		"typescript": "^7.0.2",
		"typescript-vue": "npm:typescript@^5.9.3",
		"vite": "^8.3.5",
		"vue-tsc": "^3.3.14"
	},
	"dependencies": {
		"vue": "^3.5.45"
	}
}
