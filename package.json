{
	"name": "wuwa-tappo",
	"version": "1.0.6",
	"private": true,
	"type": "commonjs",
	"author": {
		"name": "Asaki Yuki",
		"email": "noreply@asakiyuki.com"
	},
	"desktopName": "com.asakiyuki.wuwa-tappo",
	"description": "Wuwa Tappo - Desktop Companion",
	"main": "runtime/main.js",
	"scripts": {
		"start": "node scripts/start.cjs",
		"start:mac": "node scripts/start.cjs --mac",
		"start:linux": "node scripts/start.cjs --linux",
		"start:nix": "nix-shell --run 'bun start'",
		"node:build": "node scripts/clean-runtime.cjs && node scripts/build-mac-gamepad.cjs && tsc -p tsconfig.node.json",
		"renderer:build": "vite build && node scripts/write-renderer-pages.cjs && tsc --noEmit",
		"test": "npm run node:build && node --test runtime/test.js",
		"test:ui": "npm run node:build && npm run renderer:build && node scripts/test-ui.cjs",
		"build:nix": "nix-shell --run 'bun run build'",
		"build": "node scripts/build.cjs",
		"build:mac": "node scripts/build.cjs --mac",
		"build:linux": "node scripts/build.cjs --linux",
		"postinstall": "node node_modules/electron/install.js"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "45.0.0",
		"electron-builder": "26.18.0",
		"prettier": "^3.9.10",
		"sass": "^1.107.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"uiohook-napi": "1.5.5"
	},
	"overrides": {
		"minimatch": "^11.0.3"
	},
	"build": {
		"appId": "com.asakiyuki.wuwa-tappo",
		"productName": "Wuwa Tappo",
		"directories": {
			"output": "dist"
		},
		"files": [
			"runtime/**/*",
			"renderer-build/**/*",
			"assets/**/*",
			"asset-manifest.json",
			"package.json"
		],
		"asarUnpack": [
			"**/*.node",
			"assets/bin/*"
		],
		"npmRebuild": false,
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.utilities",
			"icon": "assets/appicon.icns",
			"identity": null,
			"hardenedRuntime": true,
			"gatekeeperAssess": false,
			"entitlements": "build/entitlements.mac.plist",
			"entitlementsInherit": "build/entitlements.mac.inherit.plist",
			"artifactName": "wuwa-tappo-${version}-${arch}.${ext}"
		},
		"dmg": {
			"contents": [
				{
					"x": 130,
					"y": 220
				},
				{
					"x": 410,
					"y": 220,
					"type": "link",
					"path": "/Applications"
				}
			],
			"artifactName": "wuwa-tappo-${version}-${arch}.${ext}"
		},
		"linux": {
			"target": [
				"deb",
				"rpm",
				"AppImage",
				"tar.gz"
			],
			"category": "Utility",
			"maintainer": "Asaki Yuki <noreply@asakiyuki.com>",
			"executableName": "wuwa-tappo",
			"syncDesktopName": true,
			"desktop": {
				"entry": {
					"Icon": "wuwa-tappo"
				}
			},
			"extraFiles": [
				{
					"from": "assets/appicon.png",
					"to": "appicon.png"
				}
			],
			"icon": "assets/appicon.png",
			"artifactName": "wuwa-tappo-${version}-${arch}.${ext}"
		}
	}
}
