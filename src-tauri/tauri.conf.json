{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Wuwa Tappo",
	"version": "../package.json",
	"identifier": "com.asakiyuki.wuwa-tappo",
	"build": {
		"frontendDist": "frontend",
		"beforeBuildCommand": "node scripts/tauri-prepare.cjs"
	},
	"app": {
		"withGlobalTauri": true,
		"macOSPrivateApi": true,
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": { "schemes": ["wuwa-buddy"] }
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
		"icon": ["../assets/appicon.png", "../assets/appicon.ico", "../assets/appicon.icns"]
	}
}
